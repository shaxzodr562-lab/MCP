{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SIAT sayt (web)",
      "type": "debugpy",
      "request": "launch",
      "module": "siat_mcp.api",
      "args": ["--port", "8000"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on http://127.0.0.1:(\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "SIAT MCP server (stdio)",
      "type": "debugpy",
      "request": "launch",
      "module": "siat_mcp.server",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
