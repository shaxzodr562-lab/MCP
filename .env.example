# Copy to .env and adjust. Never commit .env.
SIAT_BASE_URL=https://siat.stat.uz/api
SIAT_DB_PATH=data/siat.db
SIAT_RAW_DIR=data/raw
SIAT_ETL_WORKERS=3
SIAT_MIN_INTERVAL=0.4
SIAT_HTTP_TIMEOUT=60

# Stage 6 (LLM, optional). Free key: https://aistudio.google.com/apikey
# Empty key = rules engine only (still fully works). Set SIAT_USE_LLM=0 to switch the LLM off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SIAT_USE_LLM=1
